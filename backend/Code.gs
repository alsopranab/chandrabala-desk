/** Chandrabala Desk Google Apps Script backend. Deploy as Web App. */
const TAB='ChandrabalaData';
function setup(){const ss=SpreadsheetApp.create('Chandrabala Desk Data');const sh=ss.getSheets()[0];sh.setName(TAB);sh.getRange(1,1,1,3).setValues([['Updated','JSON State','Audit']]);const folder=DriveApp.createFolder('Chandrabala Desk Backups');PropertiesService.getScriptProperties().setProperties({SHEET_ID:ss.getId(),BACKUP_FOLDER:folder.getId()});Logger.log('Spreadsheet: '+ss.getUrl());Logger.log('Backup folder: '+folder.getUrl());}
function doGet(e){const p=PropertiesService.getScriptProperties();const token=p.getProperty('APP_TOKEN')||'';if(token&&e.parameter.token!==token)return out({error:'unauthorized'});if(e.parameter.action==='load'){const sh=getSheet();const last=sh.getLastRow();return out({state:last>=2?JSON.parse(sh.getRange(last,2).getValue()):null});}return out({ok:true,message:'Chandrabala Desk backend'});}
function doPost(e){try{const payload=JSON.parse(e.postData.contents||'{}');const p=PropertiesService.getScriptProperties();const token=p.getProperty('APP_TOKEN')||'';if(token&&payload.token!==token)return out({error:'unauthorized'});if(payload.action!=='save'||!payload.state)return out({error:'invalid request'});const sh=getSheet();const json=JSON.stringify(payload.state);sh.appendRow([new Date(),json,'save']);const folderId=p.getProperty('BACKUP_FOLDER');if(folderId&&sh.getLastRow()%20===0)DriveApp.getFolderById(folderId).createFile('backup-'+new Date().toISOString()+'.json',json,MimeType.PLAIN_TEXT);return out({ok:true});}catch(err){return out({error:String(err)});}}
function getSheet(){const id=PropertiesService.getScriptProperties().getProperty('SHEET_ID');if(!id)throw new Error('Run setup() first');const ss=SpreadsheetApp.openById(id);let sh=ss.getSheetByName(TAB);if(!sh){sh=ss.insertSheet(TAB);sh.appendRow(['Updated','JSON State','Audit']);}return sh;}
function out(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
function setAppToken(){PropertiesService.getScriptProperties().setProperty('APP_TOKEN',Utilities.getUuid()+Utilities.getUuid());Logger.log('Set APP_TOKEN; copy from Script Properties.');}
