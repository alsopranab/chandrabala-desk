/** Chandrabala Party Portal MVP. */
const P_FOLDER='1OmR8yPGZRlPo1sWQ3mhXHb9VjzB-Yv7Q';
const P_TABLES={users:'PortalUsers',bills:'PortalBills',audit:'PortalAudit'};
function setupPortal(){let p=PropertiesService.getScriptProperties(),id=p.getProperty('PORTAL_DB_ID'),ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create('Chandrabala Party Portal Data');p.setProperty('PORTAL_DB_ID',ss.getId());p.setProperty('PORTAL_FOLDER_ID',P_FOLDER);Object.entries(P_TABLES).forEach(([key,n])=>{if(!ss.getSheetByName(n)){let s=ss.insertSheet(n);s.appendRow(key==='users'?['id','name','type','email','phone','salt','hash','active','created']:key==='bills'?['id','partyId','partyName','billNo','billDate','amount','notes','fileId','fileName','status','submitted','reviewed','reviewer','remarks']:['time','actor','action','entity','id']);}});Logger.log(ss.getUrl());}
function createPortalAdmin(email,password){if(String(password).length<12)throw Error('Password must be at least 12 characters.');let s=sheet('users'),r=users();if(r.some(x=>x[2]==='ADMIN'))throw Error('Admin already exists.');let salt=Utilities.getUuid();s.appendRow([Utilities.getUuid(),'Portal Admin','ADMIN',String(email).toLowerCase(),'',salt,hash(password,salt),true,new Date()]);audit(email,'ADMIN_CREATE','user','');}
function doGet(){return HtmlService.createHtmlOutputFromFile('Portal').setTitle('Chandrabala Party Portal');}
function sheet(k){let id=PropertiesService.getScriptProperties().getProperty('PORTAL_DB_ID');if(!id)throw Error('Run setupPortal');return SpreadsheetApp.openById(id).getSheetByName(P_TABLES[k]);}
function users(){let s=sheet('users');return s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,9).getValues():[];}function bills(){let s=sheet('bills');return s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,14).getValues():[];}
function hash(p,s){let v=s+p;for(let i=0;i<1200;i++)v=Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,v));return v;}
function session(t){let v=CacheService.getScriptCache().get('p:'+t);if(!v)throw Error('Session expired; sign in again.');return JSON.parse(v);}
function login(e,p){let u=users().find(x=>String(x[3]).toLowerCase()===String(e).trim().toLowerCase()&&x[7]);if(!u||hash(String(p),u[5])!==u[6])throw Error('Invalid login or disabled account.');let t=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('p:'+t,JSON.stringify({id:u[0],name:u[1],role:u[2],email:u[3]}),14400);audit(u[3],'LOGIN','session',u[0]);return {token:t,name:u[1],role:u[2]};}
function logout(t){CacheService.getScriptCache().remove('p:'+t);return true;}
function createParty(t,d){let a=session(t);if(a.role!=='ADMIN')throw Error('Admin only.');if(!d.name||!d.email||String(d.password).length<12)throw Error('Name, email and 12+ character password required.');let e=String(d.email).toLowerCase();if(users().some(x=>String(x[3]).toLowerCase()===e))throw Error('Email already exists.');let id=Utilities.getUuid(),salt=Utilities.getUuid();sheet('users').appendRow([id,d.name,d.type||'SUPPLIER',e,d.phone||'',salt,hash(d.password,salt),true,new Date()]);audit(a.email,'CREATE_PARTY','user',id);return true;}
function listParties(t){if(session(t).role!=='ADMIN')throw Error('Admin only.');return users().filter(x=>x[2]!=='ADMIN').map(x=>({id:x[0],name:x[1],type:x[2],email:x[3],phone:x[4],active:x[7]}));}
function toggleParty(t,id,on){let a=session(t);if(a.role!=='ADMIN')throw Error('Admin only.');let r=users(),i=r.findIndex(x=>x[0]===id);if(i<0)throw Error('Not found');sheet('users').getRange(i+2,8).setValue(!!on);audit(a.email,on?'ENABLE':'DISABLE','user',id);return true;}
function submit(t,d){let a=session(t);if(a.role==='ADMIN')throw Error('Admin cannot submit.');if(!d.billNo||!d.date||!d.amount||!d.fileName||!d.data)throw Error('Bill details and file required.');let bytes=Utilities.base64Decode(d.data);if(bytes.length>8*1024*1024)throw Error('8 MB maximum.');if(!['application/pdf','image/jpeg','image/png'].includes(d.mime))throw Error('PDF, JPG or PNG only.');let f=DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty('PORTAL_FOLDER_ID')).createFile(Utilities.newBlob(bytes,d.mime,d.fileName));f.setSharing(DriveApp.Access.PRIVATE,DriveApp.Permission.NONE);let id=Utilities.getUuid();sheet('bills').appendRow([id,a.id,a.name,d.billNo,d.date,Number(d.amount),d.notes||'',f.getId(),f.getName(),'PENDING',new Date(),'','','']);audit(a.email,'SUBMIT_BILL','bill',id);return true;}
function myBills(t){let a=session(t);return bills().filter(x=>x[1]===a.id).map(obj);}
function adminBills(t,filter){let a=session(t);if(a.role!=='ADMIN')throw Error('Admin only.');return bills().filter(x=>!filter||x[9]===filter).map(obj);}
function obj(r){return {id:r[0],partyId:r[1],partyName:r[2],billNo:r[3],date:r[4] instanceof Date?Utilities.formatDate(r[4],Session.getScriptTimeZone(),'yyyy-MM-dd'):String(r[4]),amount:r[5],notes:r[6],fileName:r[8],status:r[9],remarks:r[13]};}
function review(t,id,status,remarks){let a=session(t);if(a.role!=='ADMIN'||!['APPROVED','REJECTED'].includes(status))throw Error('Unauthorized or invalid status.');if(status==='REJECTED'&&!String(remarks).trim())throw Error('Rejection reason required.');let r=bills(),i=r.findIndex(x=>x[0]===id);if(i<0||r[i][9]!=='PENDING')throw Error('Only pending bills can be reviewed.');sheet('bills').getRange(i+2,10,1,5).setValues([[status,r[i][10],new Date(),a.email,String(remarks||'')]]);audit(a.email,status,'bill',id);return true;}
function file(t,id){let a=session(t),r=bills().find(x=>x[0]===id);if(!r||(a.role!=='ADMIN'&&r[1]!==a.id))throw Error('Access denied.');let f=DriveApp.getFileById(r[7]);return {name:f.getName(),mime:f.getMimeType(),data:Utilities.base64Encode(f.getBlob().getBytes())};}
function audit(actor,action,type,id){sheet('audit').appendRow([new Date(),actor,action,type,id]);}